pkgname=decomon
pkgver=0.1.0
pkgrel=1
pkgdesc='Watch your TP-Link Deco home network: live speeds, devices, Deco units'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'python' 'openssl' 'libsecret' 'libnotify')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/decomon "$pkgdir/usr/bin/decomon"
  install -Dm755 deco "$pkgdir/usr/bin/deco"
  install -Dm644 deco-monitor.service "$pkgdir/usr/lib/systemd/user/deco-monitor.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/decomon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/decomon.svg"
  install -Dm644 "$startdir/decomon.desktop" "$pkgdir/usr/share/applications/decomon.desktop"
}
