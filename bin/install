#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build"
cd "$ROOT/pkgbuild"
makepkg -fs "$@"

# The newest package that isn't the debug one.
PACKAGE="$(ls -t "$ROOT"/pkgbuild/decomon-[0-9]*.pkg.tar.* | head -n 1)"

# sudo needs a terminal to ask for the password; without one (run from an
# editor or an agent) the desktop's own password prompt does the asking.
if [ -t 0 ]; then
    exec sudo pacman -U "$PACKAGE"
else
    exec pkexec pacman -U --noconfirm "$PACKAGE"
fi
